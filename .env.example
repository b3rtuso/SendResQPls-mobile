# ==============================================================================
# SendResQPls Mobile App - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Endpoint (REQUIRED)
# ------------------------------------------------------------------------------
# Production: https://sendresqpls.onrender.com/api
# Local Dev:  http://localhost:5000/api or http://<your-lan-ip>:5000/api for physical Android testing
VITE_API_URL=https://sendresqpls.onrender.com/api

# ------------------------------------------------------------------------------
# 2. Native Android Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
# To enable native push notifications on Android:
# 1. Open Firebase Console -> Project Settings -> General
# 2. Download "google-services.json" for package name: com.mdrrmo.balayan.sendresqpls
# 3. Place the file at: android/app/google-services.json
# Note: google-services.json should be kept out of public git repositories.
